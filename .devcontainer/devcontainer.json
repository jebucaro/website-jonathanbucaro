{
    "name": "website-jonathanbucaro",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "forwardPorts": [1313],
    "mounts": [
        "source=${devcontainerId}-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
    ],
    "postCreateCommand": "sudo chown node node_modules && pnpm install --frozen-lockfile",
    "postAttachCommand": "sh .devcontainer/allowed-signers.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "esbenp.prettier-vscode",
                "DavidAnson.vscode-markdownlint"
            ]
        }
    }
}
